# ─── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── PostgreSQL ──────────────────────────────────────────────────
# Self-hosted Postgres (shared_net service name), NOT Supabase.
DATABASE_URL=postgresql://user:password@postgresql:5432/ai_receptionist

# ─── Server ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── WhatsApp Cloud API (Meta) ───────────────────────────────────
# From Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Permanent System User token (NOT the 24h temp token). See SETUP-META.md.
WHATSAPP_ACCESS_TOKEN=EAAG...
# Any random string YOU choose; you paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=pick-a-long-random-string
# App Secret from Meta App Dashboard > Settings > Basic (used to verify webhook signatures).
WHATSAPP_APP_SECRET=your_app_secret
# Graph API version. Bump as Meta releases new ones.
WHATSAPP_API_VERSION=v23.0

# ─── Instagram DM (Meta Graph API) ───────────────────────────────
IG_VERIFY_TOKEN=pick_any_random_string
IG_APP_SECRET=your_meta_app_secret
IG_ACCESS_TOKEN=EAAG...
IG_GRAPH_VERSION=v21.0

# ─── Calendly (optional — omit for mock slots) ───────────────────
CALENDLY_API_TOKEN=

# ─── Handoff notifications ───────────────────────────────────────
HANDOFF_EMAIL_TO=bishirtijjani247@gmail.com
HANDOFF_EMAIL_FROM=noreply@ai-receptionist.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ─── Demo mode ───────────────────────────────────────────────────
# "example-spa" uses the bundled Example Spa demo config (no DB lookup).
SPA_ID=example-spa

# ─── Monitoring dashboard (/admin) ───────────────────────────────
# HTTP Basic Auth credentials. If unset, /admin returns 503.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string
