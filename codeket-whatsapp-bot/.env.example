# ─── Anthropic ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Twilio ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# ^ Twilio sandbox number. Replace with your Meta number in production.

# ─── Instagram (Meta Graph API) ──────────────────────────────────
# Instagram DM channel. Requires a Business IG account linked to a
# Facebook Page + a Meta app with instagram_manage_messages (App Review).
IG_VERIFY_TOKEN=pick_any_random_string   # also entered in Meta webhook UI
IG_APP_SECRET=your_meta_app_secret       # App Dashboard → Settings → Basic
IG_ACCESS_TOKEN=EAAG...                  # long-lived IG/Page token (Send API)
IG_GRAPH_VERSION=v21.0                   # optional, defaults to v21.0

# ─── Calendly ────────────────────────────────────────────────────
CALENDLY_API_TOKEN=eyJ...
# Get from: https://calendly.com/integrations/api_webhooks

# ─── Handoff notifications ───────────────────────────────────────
HANDOFF_EMAIL_TO=bishirtijjani247@gmail.com
HANDOFF_EMAIL_FROM=noreply@ai-receptionist.com
# SMTP (use Gmail App Password or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ─── Demo mode ───────────────────────────────────────────────────
# Set to "example-spa" to use the Example Spa demo config.
# In production, set to the client's spa ID in Supabase.
SPA_ID=example-spa
